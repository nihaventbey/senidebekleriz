{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/kategori/layout,_N_T_/kategori/[slug]/layout,_N_T_/kategori/[slug]/page,_N_T_/kategori/parklar"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/kategori/$d$slug/__PAGE__",
    "/kategori/$d$slug",
    "/kategori",
    "/_index",
    "/_head"
  ]
}