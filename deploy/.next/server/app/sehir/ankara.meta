{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/sehir/layout,_N_T_/sehir/[slug]/layout,_N_T_/sehir/[slug]/page,_N_T_/sehir/ankara"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/sehir/$d$slug/__PAGE__",
    "/sehir/$d$slug",
    "/sehir",
    "/_index",
    "/_head"
  ]
}