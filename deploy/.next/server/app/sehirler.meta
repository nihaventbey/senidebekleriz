{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/sehirler/layout,_N_T_/sehirler/page,_N_T_/sehirler"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
