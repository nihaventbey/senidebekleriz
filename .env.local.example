# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsiyonel: npm run db:migrate (Supabase Dashboard → Database → Connection string URI)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Admin seed (scripts/seed-supabase.ts, npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password
# Opsiyonel: listUsers API sorunluysa doğrudan kullanıcı id ile günceller
# ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# Site
NEXT_PUBLIC_SITE_URL=https://senidebekleriz.com

# Google Search Console (HTML tag doğrulama)
GOOGLE_SITE_VERIFICATION=

# Google AdSense (optional — varsayılan: ca-pub-8173666333919708)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-8173666333919708
NEXT_PUBLIC_ADSENSE_SLOT_HOME_HERO_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_FOOTER_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CITIES_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CITIES_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_CITY_CONTENT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CITY_LIST_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORIES_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORIES_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_CONTENT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_LIST_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_PLACE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_PLACE_CONTENT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_PLACE_SIDEBAR=

# Google Analytics & Tag Manager (optional — varsayılanlar aşağıda)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-NQYQ30WWMM
NEXT_PUBLIC_GTM_ID=GTM-W6JXQZ3K

# Wikipedia enrich script (optional)
BATCH_SIZE=50
DELAY_MS=1000
MIN_CHARS=50

# AI blog taslakları (admin /yonetim/yazilar) — Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Vercel Cron — KTB RSS etkinlik sync (/api/cron/sync-events)
# Günlük içerik keşfi (/api/cron/discover-content, her gün 07:00 UTC)
CRON_SECRET=your-random-cron-secret
